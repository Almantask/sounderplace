SESSION_SECRET=dev-session-secret-change-me
APP_URL=http://127.0.0.1:5173
ALLOW_DEV_LOGIN=1
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# OPERATOR_TOKEN=
# Comma-separated operator emails that can open /admin.
# If unset, ALLOW_DEV_LOGIN=1 only elevates signed-in users when APP_URL *and* the request host are localhost/127.0.0.1.
# Production admin requires a verified GitHub email in this list, or OPERATOR_TOKEN.
# ADMIN_EMAILS=you@example.com
